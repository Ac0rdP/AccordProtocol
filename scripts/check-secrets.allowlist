# Reviewed false positives for scripts/check-secrets.sh.
#
# Format: <path>|<exact flagged line>
# Each entry suppresses one exact line in one exact file. Add entries only for
# values that are verifiably not secrets (local development defaults, test
# fixtures, redaction placeholders). Never add a real credential, and never
# broaden an entry to a prefix or pattern.
#
# Changes to this file are security-control changes and require maintainer review.

analytics-api/README.md|DATABASE_URL=postgres://accord:accord@localhost:5432/accord_analytics \
analytics-api/README.md|TEST_DATABASE_URL=postgres://accord:accord@localhost:5432/accord_analytics \
indexer/README.md|export DATABASE_URL=postgres://accord:accord@localhost:5432/accord_indexer
indexer/test/webhooks.test.js|const SECRET = "whsec_0123456789abcdef";
scripts/security-controls.mjs|const REDACTED_SECRET = "[REDACTED_SECRET]";
