{
  "name": "accord-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Accord Protocol mobile app — proposal review and approval on the same Soroban contract as the web app",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test $(find .test-build -name '*.test.js' | sort)",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "submit:ios": "eas submit --platform ios",
    "submit:android": "eas submit --platform android"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.2.1",
    "buffer": "^6.0.3",
    "expo": "~58.0.26",
    "expo-linking": "~58.0.17",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-get-random-values": "~1.11.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.26",
    "typescript": "~6.0.2"
  }
}
