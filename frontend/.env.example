# Soroban RPC endpoint (testnet)
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Stellar network passphrase
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Deployed Accord contract ID
VITE_CONTRACT_ADDRESS=

# Any funded testnet public key — used only as simulation source (no signing required)
VITE_SIM_SOURCE=

# USDC token contract address (for balance tracking)
VITE_USDC_TOKEN_ADDRESS=

# Analytics HTTP API base URL (empty = same origin)
VITE_API_BASE_URL=

# Indexer HTTP API base URL, used by the Settings page's notification
# destinations panel (empty = same origin)
VITE_INDEXER_API_BASE_URL=

# Pull-request previews only: when "true", serve the analytics endpoints from
# the static preview-seed.json generated by scripts/seed-preview.mjs.
# Never set this in a production build.
VITE_PREVIEW_SEED=
