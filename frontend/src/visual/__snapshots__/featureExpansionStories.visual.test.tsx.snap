            Save schedule
          </button>
        </div>
      </form>
      <section
        aria-labelledby="digest-queue-heading"
        class="rounded-xl border border-zinc-800 bg-zinc-900 p-4"
      >
        <div
          class="mb-3 flex flex-wrap items-center justify-between gap-2"
        >
          <h2
            class="text-base font-semibold text-zinc-100"
            id="digest-queue-heading"
          >
            Waiting to be sent (
            2
            )
          </h2>
          <button
            class="min-h-11 rounded-lg bg-zinc-800 px-3 text-sm text-zinc-200 hover:bg-zinc-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 focus-visible:ring-offset-2 focus-visible:ring-offset-zinc-950"
            type="button"
          >
            Discard queued alerts
          </button>
        </div>
        <ul
          class="divide-y divide-zinc-800"
        >
          <li
            class="py-2 text-sm"
          >
            <div
              class="flex flex-wrap items-center justify-between gap-2"
            >
              <span
                class="font-medium text-zinc-100"
              >
                Proposal Approved
              </span>
              <span
                class="text-xs text-zinc-400"
              >
                In next digest
                 ·
                 
                Thu, Nov 19, 10:05 AM
              </span>
            </div>
            <p
              class="text-zinc-400"
            >
              Proposal #14 received a new approval (2/3).
            </p>
          </li>
          <li
            class="py-2 text-sm"
          >
            <div
              class="flex flex-wrap items-center justify-between gap-2"
            >
              <span
                class="font-medium text-zinc-100"
              >
                Proposal Ready
              </span>
              <span
                class="text-xs text-zinc-400"
              >
                Held for quiet hours
                 ·
                 
                Thu, Nov 19, 11:10 PM
              </span>
            </div>
            <p
              class="text-zinc-400"
            >
              Proposal #12 has reached quorum and is ready to execute.
            </p>
          </li>
        </ul>
      </section>
    </div>
  </div>
</div>
`;

