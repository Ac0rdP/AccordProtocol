          </p>
        </fieldset>
        <div
          aria-live="polite"
        />
        <div
          class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end"
        >
          <button
            class="min-h-11 rounded-lg bg-zinc-800 px-4 text-sm text-zinc-200 hover:bg-zinc-700 disabled:opacity-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 focus-visible:ring-offset-2 focus-visible:ring-offset-zinc-950"
            disabled=""
            type="button"
          >
            Discard changes
          </button>
          <button
            class="min-h-11 rounded-lg bg-emerald-600 px-4 text-sm font-medium text-white hover:bg-emerald-500 disabled:opacity-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 focus-visible:ring-offset-2 focus-visible:ring-offset-zinc-950"
            disabled=""
