            365
            -day delegation.
          </p>
        </div>
        <button
          aria-label="Create delegation"
          class="w-full bg-emerald-600 hover:bg-emerald-500 disabled:opacity-50 disabled:cursor-not-allowed text-white py-2.5 rounded-lg font-medium transition-colors focus:ring-2 focus:ring-zinc-400 focus:outline-none"
          type="button"
        >
          Delegate
        </button>
      </div>
    </div>
  </div>
</div>
`;

