          </label>
          <select
            aria-label="Delegate to owner"
            class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-2.5 text-white text-sm focus:ring-2 focus:ring-zinc-400 focus:outline-none focus:border-zinc-500"
            id="delegate-address"
          >
            <option
              value="GBPLX2P3VWYKPQ7L5RI5OGXQ6T4G7QZMJ3HPQD7FZX5KJ3H2Z4YK5ABC"
            >
              Bob
               (
              GBPLX2...5ABC
              )
            </option>
          </select>
        </div>
        <div>
          <label
            class="text-xs text-zinc-400 block mb-1.5"
            for="delegate-expiry"
          >
            Expiry (optional)
          </label>
          <input
            aria-label="Delegation expiry"
            class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-2.5 text-white text-sm focus:ring-2 focus:ring-zinc-400 focus:outline-none focus:border-zinc-500"
            id="delegate-expiry"
            type="date"
            value=""
          />
          <p
            class="text-xs text-zinc-500 mt-1"
          >
