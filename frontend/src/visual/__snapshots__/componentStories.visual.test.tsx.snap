      class="bg-zinc-900 border border-zinc-700 rounded-2xl p-6 w-full max-w-md"
    >
      <div
        class="flex items-center justify-between mb-5"
      >
        <div>
          <h2
            class="text-white font-semibold text-lg"
          >
            Propose Resume
          </h2>
          <p
            class="text-xs text-zinc-500 font-mono mt-0.5"
          >
            Schedule #
            3
          </p>
        </div>
        <button
          aria-label="Close"
          class="text-zinc-500 hover:text-zinc-300 text-xl focus:ring-2 focus:ring-zinc-400 focus:outline-none rounded-md"
          type="button"
        >
          ✕
        </button>
      </div>
      <div
        class="space-y-4"
      >
        <p
          class="text-sm text-zinc-400"
        >
          This creates a governance proposal to resume schedule
           
          <span
            class="text-white font-mono"
          >
            #
            3
          </span>
          . It requires multisig approval before taking effect.
        </p>
        <div>
          <label
            class="text-xs text-zinc-400 block mb-1.5"
          >
            Description 
            <span
              class="text-zinc-600"
            >
              (optional)
            </span>
          </label>
          <textarea
            class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-2.5 text-white text-sm placeholder-zinc-600 focus:ring-2 focus:ring-zinc-400 focus:outline-none focus:border-zinc-500 resize-none"
            placeholder="Reason for this proposal…"
            rows="2"
          />
        </div>
        <div>
          <label
            class="text-xs text-zinc-400 block mb-1.5"
          >
            Voting deadline (days)
          </label>
          <input
            class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-2.5 text-white text-sm focus:ring-2 focus:ring-zinc-400 focus:outline-none focus:border-zinc-500"
            max="90"
            min="1"
            type="number"
            value="7"
          />
        </div>
        <div
          class="flex gap-2 pt-1"
        >
          <button
            class="flex-1 rounded-lg border border-zinc-700 bg-zinc-800 px-4 py-2.5 text-sm font-medium text-zinc-300 hover:bg-zinc-700 transition-colors focus:outline-none focus:ring-2 focus:ring-zinc-400"
            type="button"
          >
            Cancel
          </button>
          <button
            class="flex-1 rounded-lg bg-yellow-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-yellow-500 disabled:opacity-50 disabled:cursor-not-allowed transition-colors focus:outline-none focus:ring-2 focus:ring-zinc-400"
            type="button"
          >
            Propose Resume
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
`;

