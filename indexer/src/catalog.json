      "role": "Role",
      "before": "Vec<Role>",
      "after": "Vec<Role>"
    }
  },
  "role_revoked": {
    "struct": "RoleRevokedEvent",
    "fields": {
      "target": "Address",
      "role": "Role",
      "before": "Vec<Role>",
      "after": "Vec<Role>"
    }
  }
