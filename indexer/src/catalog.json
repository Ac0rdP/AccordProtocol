      "threshold": "u32",
      "weight": "u32",
      "cumulative_weight": "u32"
    }
  },
  "revoked": {
    "struct": "ProposalRevokedEvent",
    "fields": {
      "id": "u64",
      "approver": "Address",
      "approvals": "u32",
      "weight": "u32",
      "cumulative_weight": "u32"
    }
  },
  "executed": {
    "struct": "ProposalExecutedEvent",
    "fields": {
