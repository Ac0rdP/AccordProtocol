      "owner_count": "u32",
      "total_weight": "u32"
    }
  },
  "rbac_migrated": {
    "struct": "RbacMigratedEvent",
    "fields": {
      "owner_count": "u32",
      "role_version": "u32"
    }
  },
  "created": {
    "struct": "ProposalCreatedEvent",
    "fields": {
      "id": "u64",
      "proposer": "Address",
      "threshold": "u32",
      "category": "ProposalCategory",
      "transfers": "Vec<Transfer>",
      "quorum_weight": "u32",
      "total_weight_at_creation": "u32"
    }
  },
  "rpay": {
    "struct": "RecurringPaymentDisbursedEvent",
    "fields": {
      "schedule_id": "u64",
      "recipient": "Address",
      "token": "Address",
